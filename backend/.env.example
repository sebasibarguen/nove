# Database
DATABASE_URL=postgresql+asyncpg://nove:nove@localhost:5433/nove

# Auth
JWT_SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Main healthspan callback. Register in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://app.nove.health/auth/google/callback
# Pulse subdomain callback. Must be registered as an additional authorized
# redirect URI in Google Cloud Console. Lets the OAuth callback land on pulse.*
# so localStorage tokens stay scoped to the right origin.
PULSE_GOOGLE_REDIRECT_URI=https://pulse.nove.health/auth/google/callback

# CORS — comma-separated list of allowed origins. Include every brand subdomain.
CORS_ORIGINS=https://app.nove.health,https://pulse.nove.health,https://nove.health

# Anthropic
ANTHROPIC_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nove-labs

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postmark
POSTMARK_SERVER_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry
SENTRY_DSN=

# App
DEBUG=true
